<Window x:Class="PollingClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PollingClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="User ID: " FontWeight="Bold"/>
            <TextBox x:Name="TxtUserId" Margin=" 0, 0, 0, 10" Text="UserB" />

            <TextBlock Text=" Channel Name: " FontWeight="Bold" />
            <TextBox x:Name="TxtChannelName" Margin=" 0, 0, 0, 10" Text="General" />

            <Button Content="Create Channel" Click="CreateChannelButton_Click" Margin=" 0, 0, 0, 5"/>
            <Button Content="Join Channel" Click="JoinChannelButton_Click" Margin=" 0, 0, 0, 15"/>

            <TextBlock Text=" Active Members: " FontWeight="Bold" />
            <ListBox x:Name="MemberList" Height=" 150 "/>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox x:Name="MessageList" Grid.Row="0" Margin="0,0,0,10"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtMessage" Grid.Column="0" Margin="0,0,0,5"/>
                <Button Content="Send" Grid.Column="1" Click="SendButton_CLick"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
