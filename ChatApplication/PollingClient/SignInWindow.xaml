<Window x:Class="PollingClient.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Application - Sign In"
        Height="230"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Sign In"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1"
                   Text="Enter your User ID:"
                   FontSize="14"
                   Margin="0,0,0,5"/>

        <TextBox x:Name="UserIdTextBox"
                 Grid.Row="2"
                 Height="30"
                 FontSize="14"
                 Margin="0,0,0,15"/>

        <Button x:Name="SignInButton"
                Grid.Row="3"
                Content="Sign In"
                Width="120"
                Height="35"
                HorizontalAlignment="Center"
                Click="SignInButton_Click"/>
    </Grid>
</Window>
