<Window x:Class="DuplexClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DuplexClient"
        mc:Ignorable="d"
        Title="Duplex Client - Chat" Height="650" Width="730">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="User ID:" FontWeight="Bold" />
            <TextBox x:Name="TxtUserId" Margin="0,0,0,10" IsReadOnly="True" />
            <TextBlock x:Name="StatusText" Text="Not signed in" Margin="0,0,0,10" TextWrapping="Wrap" />
            <Button x:Name="SignInButton" Visibility="Collapsed" Click="SignInButton_Click" />

            <TextBlock Text="Channel Name:" FontWeight="Bold" />
            <TextBox x:Name="TxtNewChannelName" Margin="0,0,0,5" ToolTip="New channel name" />
            <Button x:Name="CreateChannelButton" Content="Create Channel" Click="CreateChannelButton_Click" Margin="0,0,0,5" />
            <Button x:Name="JoinChannelButton" Content="Join Selected Channel" Click="JoinChannelButton_Click" Margin="0,0,0,5" />
            <Button x:Name="LeaveChannelButton" Content="Leave Channel" Click="LeaveChannelButton_Click" Margin="0,0,0,10" />

            <TextBlock Text="Available Channels:" FontWeight="Bold" />
            <ListBox x:Name="ChannelList" Height="80" Margin="0,0,0,8" />
            <TextBlock x:Name="CurrentChannelText" Text="Current Channel: None" TextWrapping="Wrap" Margin="0,0,0,8" />

            <TextBlock Text="Active Members:" FontWeight="Bold" />
            <ListBox x:Name="MemberList" Height="120" />
            <TextBlock Text="Type a username to open a private conversation:" TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBox x:Name="TxtPrivateRecipient" Margin="0,5,0,5" ToolTip="Member user ID" />
            <Button Content="Open Private Conversation" Click="OpenPrivateConversationButton_Click" Margin="0,0,0,5" />

            <TextBlock Text="Shared Files:" FontWeight="Bold" Margin="0,5,0,0" />
            <ListBox x:Name="FileList" Height="70" MouseDoubleClick="FileList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FileName}" />
                            <TextBlock Text=" (" />
                            <TextBlock Text="{Binding Length}" />
                            <TextBlock Text=" bytes)" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Share File" Click="ShareFileButton_Click" Margin="0,5,0,5" />
            <Button Content="Sign Out" Click="SignOutButton_Click" />
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="MessageList" Grid.Row="0" Margin="0,0,0,10" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtMessage" Grid.Column="0" Margin="0,0,5,0" />
                <Button x:Name="SendMessageButton" Grid.Column="1" Content="Send" Click="SendMessageButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
